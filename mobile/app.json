{
  "expo": {
    "name": "ViChat",
    "slug": "vichat-mobile",
    "scheme": "vichat",
    "description": "ViChat doanh nghiệp - kết nối nội bộ an toàn",
    "version": "1.0.55",
    "orientation": "portrait",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F5F0",
    "primaryColor": "#F4511E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.upgo.vichat",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSCameraUsageDescription": "ViChat cần camera để thực hiện cuộc gọi video.",
        "NSMicrophoneUsageDescription": "ViChat cần micro để thực hiện cuộc gọi thoại và video.",
        "NSLocationWhenInUseUsageDescription": "ViChat cần quyền vị trí để chia sẻ vị trí của bạn.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ViChat cần vị trí để chia sẻ hành trình trực tiếp của bạn."
      }
    },
    "android": {
      "package": "vn.upgo.vichat",
      "versionCode": 56,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F7F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F5F0"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "ViChat cần camera để quét mã QR và thực hiện cuộc gọi video."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ViChat cần truy cập ảnh để gửi trong cuộc trò chuyện.",
          "cameraPermission": "ViChat cần camera để chụp ảnh gửi trong cuộc trò chuyện.",
          "microphonePermission": "ViChat cần quyền micro để thực hiện cuộc gọi thoại và video."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#F4511E",
          "defaultChannel": "messages-v2"
        }
      ]
    ]
  }
}
