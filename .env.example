# Set these values in the hosting provider to enable live Tinode mode.
# Leave VITE_TINODE_HOST empty to keep the local/demo fallback.
# Local Tinode created by infrastructure/tinode/start.ps1:
VITE_TINODE_HOST=127.0.0.1:6060
VITE_TINODE_API_KEY=AQEAAAABAAD_rAp4DJh05a1HAwFT3A6K
VITE_TINODE_SECURE=false
VITE_TINODE_TRANSPORT=ws
# Keep the Tinode browser cache off; realtime history remains authoritative on chatapi.
VITE_TINODE_PERSIST=false
VITE_TINODE_APP_NAME=SONGHONG/1.0

# Company-owned management service. It owns auth, tenant-scoped users, and
# conversation metadata. Authentication is required for internal deployments.
VITE_CHAT_MANAGEMENT_API_URL=/chatmgt-api
VITE_CHAT_MANAGEMENT_REMOTE_AUTH=true
# Optional legacy/local-password tenant; UpGo Account login is tenant-dynamic.
VITE_CHAT_TENANT_ID=
VITE_CHAT_AUTH_MODE=account_password
VITE_CALLS_ENABLED=true
VITE_ACCOUNT_URL=https://account.upgo.vn
VITE_CHAT_MODE=external

# ChatUI calls Chatmgt; Chatmgt forwards the message to the external chatbot.
VITE_CHATBOT_API_URL=/chatmgt-api/api/v1/chatbot/message
VITE_CHATBOT_KNOWLEDGE_BASE_ID=
VITE_CHATBOT_WITH_CREDENTIALS=true
VITE_CHATBOT_ID=vichat-ai
VITE_CHATBOT_USERNAME=vichat_ai
VITE_CHATBOT_DISPLAY_NAME=ViChat AI
VITE_CHATBOT_DISPLAY_TITLE=Trợ lý tri thức doanh nghiệp
VITE_CHATBOT_DISPLAY_ORGANIZATION=GON Platform
VITE_CHATBOT_DISPLAY_AVATAR=/vichat-ai.svg
