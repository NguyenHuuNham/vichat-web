# Set these values in the hosting provider to enable live Tinode mode.
# Leave VITE_TINODE_HOST empty to keep the local/demo fallback.
# Local Tinode created by infrastructure/tinode/start.ps1:
VITE_TINODE_HOST=127.0.0.1:6060
VITE_TINODE_API_KEY=AQEAAAABAAD_rAp4DJh05a1HAwFT3A6K
VITE_TINODE_SECURE=false
VITE_TINODE_TRANSPORT=ws
VITE_TINODE_PERSIST=true
VITE_TINODE_APP_NAME=SONGHONG/1.0

# Company-owned management service. It owns auth, tenant-scoped users, and
# conversation metadata. Authentication is required for internal deployments.
VITE_CHAT_MANAGEMENT_API_URL=/management-api
VITE_CHAT_MANAGEMENT_REMOTE_AUTH=true
VITE_CHAT_TENANT_ID=song-hong

# API chatbot của chatservice, ví dụ: https://chat.example.vn/api/v1/chatbot/message
# Để trống thì giao diện dùng chế độ trả lời an toàn nội bộ.
VITE_CHATBOT_API_URL=/api/v1/chatbot/message
VITE_CHATBOT_KNOWLEDGE_BASE_ID=
VITE_CHATBOT_WITH_CREDENTIALS=true
