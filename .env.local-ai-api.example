# Copy this file to .env.local-ai-api. The real file is ignored by Git.
LOCAL_AI_HOST=0.0.0.0
LOCAL_AI_PORT=8000
LOCAL_AI_API_TOKEN=replace-with-a-long-random-token

# Knowledge API supplied by the other team.
LOCAL_AI_KNOWLEDGE_URL=https://knowledge-ai.gonapp.net/api/v1/chat
LOCAL_AI_KNOWLEDGE_KEY=replace-with-knowledge-api-key
LOCAL_AI_KNOWLEDGE_HEADER=X-API-Key
LOCAL_AI_KNOWLEDGE_SCHEME=
LOCAL_AI_TOP_K=5

# Local model endpoint. Ollama is the default; keep model files on drive D.
LOCAL_AI_LLM_URL=http://127.0.0.1:11434/api/chat
LOCAL_AI_LLM_MODEL=qwen2.5:1.5b
LOCAL_AI_LLM_FORMAT=ollama
LOCAL_AI_LLM_KEY=
LOCAL_AI_MAX_TOKENS=256
LOCAL_AI_TIMEOUT=90
LOCAL_AI_CORS_ORIGIN=
LOCAL_AI_MOCK=false
