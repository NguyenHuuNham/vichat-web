FROM node:22-alpine AS management-ui-build

WORKDIR /web

ARG VITE_CHAT_TENANT_ID=song-hong
ENV VITE_CHAT_TENANT_ID=$VITE_CHAT_TENANT_ID

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build:production

FROM python:3.9-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY chatservice-main/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN sed -i 's/asyncio\.Task\.current_task/asyncio.current_task/g' /usr/local/lib/python3.9/site-packages/gatco_sqlalchemy/__init__.py

COPY chatservice-main/ .
COPY --from=management-ui-build /web/dist /app/management-ui

EXPOSE 8093
CMD ["python", "manage.py", "run"]
