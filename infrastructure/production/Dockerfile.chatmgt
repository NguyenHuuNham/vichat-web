FROM node:22.22.0-alpine3.23@sha256:e4bf2a82ad0a4037d28035ae71529873c069b13eb0455466ae0bc13363826e34 AS management-ui-build

WORKDIR /web

ARG VITE_CHAT_TENANT_ID=song-hong
ENV VITE_CHAT_TENANT_ID=$VITE_CHAT_TENANT_ID

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build:production

FROM python:3.9.23-slim-bookworm@sha256:7bffea15bcc3d7fb87cf10a027986203e4281e078fa2f5b234c30fca291f0834

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates build-essential libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY chatservice-main/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
RUN sed -i 's/asyncio\.Task\.current_task/asyncio.current_task/g' /usr/local/lib/python3.9/site-packages/gatco_sqlalchemy/__init__.py

COPY chatservice-main/ .
COPY --from=management-ui-build /web/dist /app/management-ui

EXPOSE 8093
CMD ["python", "manage.py", "run"]
