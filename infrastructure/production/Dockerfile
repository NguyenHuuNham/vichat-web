FROM node:22.22.0-alpine3.23@sha256:e4bf2a82ad0a4037d28035ae71529873c069b13eb0455466ae0bc13363826e34 AS build

WORKDIR /app

ARG VITE_TINODE_HOST
ARG VITE_TINODE_API_KEY
ARG VITE_TINODE_SECURE=true
ARG VITE_TINODE_TRANSPORT=ws
ARG VITE_TINODE_PERSIST=false
ARG VITE_TINODE_APP_NAME=SONGHONG/1.0
ARG VITE_CHATBOT_API_URL=
ARG VITE_CHATBOT_WITH_CREDENTIALS=true
ARG VITE_CHATBOT_ID=vichat-ai
ARG VITE_CHATBOT_USERNAME=vichat_ai
ARG VITE_CHATBOT_DISPLAY_NAME=ViChat AI
ARG VITE_CHATBOT_DISPLAY_TITLE=Tro ly tri thuc doanh nghiep
ARG VITE_CHATBOT_DISPLAY_ORGANIZATION=GON Platform
ARG VITE_CHATBOT_DISPLAY_AVATAR=/vichat-ai.svg
ARG VITE_CHAT_MANAGEMENT_API_URL=/chatmgt-api
ARG VITE_CHAT_MANAGEMENT_REMOTE_AUTH=true
ARG VITE_CHAT_TENANT_ID=
ARG VITE_CHAT_AUTH_MODE=account_password
ARG VITE_CHAT_MEDIA_STORAGE=tinode
ARG VITE_CHAT_MEDIA_FALLBACK_TO_TINODE=false
ARG VITE_CALLS_ENABLED=true
ARG VITE_CHAT_MODE=internal

ENV VITE_TINODE_HOST=$VITE_TINODE_HOST \
    VITE_TINODE_API_KEY=$VITE_TINODE_API_KEY \
    VITE_TINODE_SECURE=$VITE_TINODE_SECURE \
    VITE_TINODE_TRANSPORT=$VITE_TINODE_TRANSPORT \
    VITE_TINODE_PERSIST=$VITE_TINODE_PERSIST \
    VITE_TINODE_APP_NAME=$VITE_TINODE_APP_NAME \
    VITE_CHATBOT_API_URL=$VITE_CHATBOT_API_URL \
    VITE_CHATBOT_WITH_CREDENTIALS=$VITE_CHATBOT_WITH_CREDENTIALS \
    VITE_CHATBOT_ID=$VITE_CHATBOT_ID \
    VITE_CHATBOT_USERNAME=$VITE_CHATBOT_USERNAME \
    VITE_CHATBOT_DISPLAY_NAME=$VITE_CHATBOT_DISPLAY_NAME \
    VITE_CHATBOT_DISPLAY_TITLE=$VITE_CHATBOT_DISPLAY_TITLE \
    VITE_CHATBOT_DISPLAY_ORGANIZATION=$VITE_CHATBOT_DISPLAY_ORGANIZATION \
    VITE_CHATBOT_DISPLAY_AVATAR=$VITE_CHATBOT_DISPLAY_AVATAR \
    VITE_CHAT_MANAGEMENT_API_URL=$VITE_CHAT_MANAGEMENT_API_URL \
    VITE_CHAT_MANAGEMENT_REMOTE_AUTH=$VITE_CHAT_MANAGEMENT_REMOTE_AUTH \
    VITE_CHAT_TENANT_ID=$VITE_CHAT_TENANT_ID \
    VITE_CHAT_AUTH_MODE=$VITE_CHAT_AUTH_MODE \
    VITE_CHAT_MEDIA_STORAGE=$VITE_CHAT_MEDIA_STORAGE \
    VITE_CHAT_MEDIA_FALLBACK_TO_TINODE=$VITE_CHAT_MEDIA_FALLBACK_TO_TINODE \
    VITE_CALLS_ENABLED=$VITE_CALLS_ENABLED \
    VITE_CHAT_MODE=$VITE_CHAT_MODE

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build:production

FROM nginx:1.28.1-alpine@sha256:52e3ada4d978443601f286cc2f9e7b95c82aa3ad5a78ce9c6b94ce00258e68cc

COPY infrastructure/production/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# Release archives can preserve restrictive source modes; nginx workers need to read public assets.
RUN chmod -R a+rX /usr/share/nginx/html

EXPOSE 80
