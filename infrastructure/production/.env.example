PUBLIC_HOST=chat.upgo.vn
PUBLIC_HTTP_PORT=8094
PUBLIC_SECURE=true
ALLOW_INSECURE_HTTP=false
VERIFY_PUBLIC_URLS=true

CHATMGT_BIND_HOST=127.0.0.1
CHATMGT_PUBLIC_PORT=8081
CHAT_MANAGEMENT_PUBLIC_URL=https://chatmgt.upgo.vn
SESSION_COOKIE_DOMAIN=chatmgt.upgo.vn
VITE_CHAT_MODE=internal
VITE_CHAT_AUTH_MODE=account_password
VITE_CALLS_ENABLED=true
VITE_CHATBOT_ID=external-chatbot
VITE_CHATBOT_USERNAME=external_bot
VITE_CHATBOT_DISPLAY_NAME=External AI
VITE_CHATBOT_DISPLAY_TITLE=External chatbot
VITE_CHATBOT_DISPLAY_ORGANIZATION=Connected service
VITE_CHATBOT_DISPLAY_AVATAR=/favicon.svg

# Employees authenticate with UpGO Account membership invited by the tenant
# administrator. Chatmgt keeps a read-only projection and Tinode mapping.
CHAT_ACCOUNT_SSO_ENABLED=true
CHAT_ACCOUNT_CREDENTIAL_LOGIN_ENABLED=true
CHAT_MOBILE_BEARER_ENABLED=true
CHATMGT_ADMIN_ACCOUNT_SSO_ENABLED=true
ACCOUNT_URL=https://account.upgo.vn
ACCOUNT_SSO_LOGIN_PATH=/login
ACCOUNT_SSO_PROFILE_PATH=/current_user
ACCOUNT_SSO_DIRECTORY_PATH=/api/v1/tenant_user
ACCOUNT_SSO_LOGOUT_PATH=/logout
ACCOUNT_SSO_SELF_PROFILE_PATH=/me
ACCOUNT_SSO_USER_UPDATE_PATH=/api/v1/user
ACCOUNT_AVATAR_UPLOAD_URL=https://service.upgo.vn/api/image/upload?path=accounts
ACCOUNT_SSO_TIMEOUT=10
ACCOUNT_SSO_DIRECTORY_SYNC_TTL=10
ACCOUNT_SESSION_COOKIE_NAME=session
ACCOUNT_SESSION_COOKIE_DOMAIN=.upgo.vn
ACCOUNT_SESSION_COOKIE_SECURE=true

TINODE_API_KEY=AQEAAAABAAD_rAp4DJh05a1HAwFT3A6K
TINODE_DB_PASSWORD=replace-with-a-long-random-password
TINODE_AUTH_TOKEN_KEY=replace-with-base64-of-32-random-bytes
TINODE_UID_ENCRYPTION_KEY=replace-with-base64-of-16-random-bytes
# start.sh generates this tenant-scoped credential derivation key when empty.
TINODE_SSO_SECRET=
TINODE_MIRROR_LOCAL_CREDENTIALS=true
TINODE_TOKEN_EXPIRE_IN=300
TINODE_CENTRAL_TOKEN_MAX_TTL=1209600
TINODE_UPGRADE_DB=false
TINODE_CORS_ORIGINS=["https://chat.upgo.vn"]
WEBRTC_ENABLED=true
# Keep the provider firewall open for TCP/UDP 3478 and UDP 49160-49200.
TURN_HOST=replace-with-turn-host-or-public-ip
TURN_PORT=3478
TURN_REALM=chat.upgo.vn
TURN_USERNAME=vichat
TURN_PASSWORD=replace-with-a-long-random-password
# Coturn runs on the host network. Use public-ip/private-interface-ip when NAT is present.
TURN_EXTERNAL_IP=replace-with-public-ip/private-interface-ip
TURN_PRIVATE_IP=replace-with-private-interface-ip
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200

CHATSERVICE_DB_NAME=chatservice
CHATSERVICE_DB_USER=chatservice
CHATSERVICE_DB_PASSWORD=replace-with-a-long-random-password
APP_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_PASSWORD_SALT=replace-with-at-least-16-random-characters
SESSION_COOKIE_SALT=replace-with-at-least-32-random-characters
CHAT_AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
CHAT_CORS_ORIGINS=["https://chat.upgo.vn"]
CHAT_AUTH_ACCESS_TTL=28800
CHAT_AUTH_COOKIE_SECURE=true
CHAT_AUTH_MAX_FAILURES=5
CHAT_AUTH_FAILURE_WINDOW=900
CHAT_PASSWORD_RESET_TTL=1800
CHAT_PASSWORD_RESET_MAX_REQUESTS=3
CHAT_PASSWORD_RESET_WINDOW=900
CHAT_PASSWORD_RESET_URL=https://chat.upgo.vn/?reset_token={token}
CHAT_PASSWORD_RESET_DEBUG=false
CHAT_SMTP_HOST=
CHAT_SMTP_PORT=587
CHAT_SMTP_USERNAME=
CHAT_SMTP_PASSWORD=
CHAT_SMTP_FROM=
CHAT_SMTP_STARTTLS=true
CHAT_SMTP_SSL=false
TINODE_ADMIN_USERNAME=admin
TINODE_ADMIN_PASSWORD=replace-with-the-tinode-root-password
CHATMGT_BOOTSTRAP_ADMIN_FULL_NAME=VICHAT Administrator
CHATMGT_BOOTSTRAP_ADMIN_EMAIL=admin@chat.upgo.vn
# Central Tinode relay: Chatmgt -> ChatUI Nginx -> https://web.vichat.net.
# Do not point this back to chatapi after the migration is accepted.
TINODE_INTERNAL_WS_URL=ws://chat:80/v0/channels
TINODE_CENTRAL_WS_URL=wss://web.vichat.net/v0/channels
TINODE_BRIDGE_TIMEOUT=15
TINODE_BRIDGE_INTERNAL_KEY=

CHATMGT_DEFAULT_TENANT=tn6913580727957397
TINODE_AUTH_TIMEOUT=10

CHATBOT_ENABLED=true
CHATBOT_REQUIRE_AUTH=true
CHATBOT_PROVIDER=external-webhook
CHATBOT_API_URL=https://knowledge.gonapp.net/api/v1/chat
CHATBOT_API_KEY=
CHATBOT_MODEL=
CHATBOT_EXTERNAL_AUTH_HEADER=Authorization
CHATBOT_EXTERNAL_AUTH_SCHEME=Bearer
CHATBOT_EXTERNAL_API_KEY=replace-with-a-separate-inbound-api-key
CHATBOT_EXTERNAL_TENANT=tn6913580727957397
CHATBOT_EXTERNAL_KNOWLEDGE_BASE_ID=
TINODE_CHATBOT_ENABLED=true
TINODE_CHATBOT_USERNAME=upgo_chatbot
TINODE_CHATBOT_PASSWORD=replace-with-a-long-random-password
TINODE_CHATBOT_DISPLAY_NAME=ViChat AI
TINODE_CHATBOT_DISPLAY_TITLE=Tro ly AI
TINODE_CHATBOT_DISPLAY_ORGANIZATION=GON Platform
TINODE_CHATBOT_DISPLAY_AVATAR=/favicon.svg
TINODE_CHATBOT_WEBHOOK_KEY=replace-with-a-separate-random-webhook-key
TINODE_CHATBOT_WEBHOOK_URL=http://chatmgt:8093/api/v1/chatbot/tinode-webhook
TINODE_CHATBOT_WEBHOOK_TIMEOUT=40
TINODE_CHATBOT_HISTORY_LIMIT=100
TINODE_CHATBOT_FAILURE_REPLY=Tro ly AI dang tam thoi khong phan hoi. Vui long thu lai sau.
CHATBOT_TIMEOUT=30
CHATBOT_TEMPERATURE=0.2
CHATBOT_MAX_TOKENS=800
CHATBOT_MAX_INPUT_LENGTH=4000
CHATBOT_DEFAULT_TENANT=tn6913580727957397
CHATBOT_KNOWLEDGE_ONLY=false
CHATBOT_KNOWLEDGE_REQUIRE_AUTH=true
CHATBOT_RETRIEVAL_LIMIT=6
CHATBOT_RETRIEVAL_CANDIDATES=500
CHATBOT_CHUNK_SIZE=1400
CHATBOT_CHUNK_OVERLAP=180
CHATBOT_MAX_KNOWLEDGE_FILE_SIZE=20971520
