# start.ps1 creates infrastructure/tinode/.env with random secrets.
TINODE_DB_PASSWORD=replace-with-a-long-random-password
TINODE_AUTH_TOKEN_KEY=replace-with-base64-of-32-random-bytes
TINODE_UID_ENCRYPTION_KEY=replace-with-base64-of-16-random-bytes
TINODE_TOKEN_EXPIRE_IN=300
TINODE_PORT=6060
TINODE_UPGRADE_DB=false
TINODE_CORS_ORIGINS=["*"]
TNPG_PUSH_ENABLED=false
TNPG_AUTH_TOKEN=
TNPG_ORG=
FCM_PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_CRED_FILE=/data/runtime/firebase-service-account.json
FCM_INCLUDE_ANDROID_NOTIFICATION=false
FCM_INCLUDE_IOS_NOTIFICATION=false
