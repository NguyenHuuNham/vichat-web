# External chatbot running beside a directly started Chatmgt process.
CHATBOT_ENABLED=true
CHATBOT_REQUIRE_AUTH=true
CHATBOT_PROVIDER=external-webhook
CHATBOT_API_URL=https://knowledge-ai.gonapp.net/api/v1/chat
CHATBOT_API_KEY=replace-with-knowledge-ai-api-key
CHATBOT_MODEL=
CHATBOT_EXTERNAL_AUTH_HEADER=X-API-Key
CHATBOT_EXTERNAL_AUTH_SCHEME=
CHATBOT_EXTERNAL_REQUEST_MODE=knowledge-retrieval
CHATBOT_TIMEOUT=30
CHATBOT_TEMPERATURE=0.2
CHATBOT_MAX_TOKENS=800
CHATBOT_MAX_INPUT_LENGTH=4000
CHATBOT_DEFAULT_TENANT=songhong

# Tinode identity/display metadata. Keep credentials and webhook keys private.
TINODE_CHATBOT_DISPLAY_NAME=ViChat AI
TINODE_CHATBOT_DISPLAY_TITLE=Tro ly tri thuc doanh nghiep
TINODE_CHATBOT_DISPLAY_ORGANIZATION=GON Platform
TINODE_CHATBOT_DISPLAY_AVATAR=https://chat.upgo.vn/vichat-ai.svg

# Chỉ trả lời khi tìm thấy dữ liệu nội bộ phù hợp.
CHATBOT_KNOWLEDGE_ONLY=false
CHATBOT_KNOWLEDGE_REQUIRE_AUTH=true
CHATBOT_RETRIEVAL_LIMIT=6
CHATBOT_RETRIEVAL_CANDIDATES=500
CHATBOT_CHUNK_SIZE=1400
CHATBOT_CHUNK_OVERLAP=180
CHATBOT_MAX_KNOWLEDGE_FILE_SIZE=20971520

# Inbound data API for a partner chatbot. Keep this key separate from
# CHATBOT_API_KEY and pin the tenant/knowledge base on the server.
CHATBOT_EXTERNAL_API_KEY=
CHATBOT_EXTERNAL_TENANT=songhong
CHATBOT_EXTERNAL_KNOWLEDGE_BASE_ID=

# Có thể ghi đè prompt mặc định bằng một dòng duy nhất.
CHATBOT_SYSTEM_PROMPT=
