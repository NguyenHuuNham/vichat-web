# Bật chatbot sau khi đã khai báo đầy đủ endpoint và API key.
CHATBOT_ENABLED=true
CHATBOT_REQUIRE_AUTH=true
CHATBOT_PROVIDER=openai-compatible
CHATBOT_API_URL=https://api.openai.com/v1/chat/completions
CHATBOT_API_KEY=
CHATBOT_MODEL=your-model-name
CHATBOT_TIMEOUT=30
CHATBOT_TEMPERATURE=0.2
CHATBOT_MAX_TOKENS=800
CHATBOT_MAX_INPUT_LENGTH=4000
CHATBOT_DEFAULT_TENANT=songhong

# Chỉ trả lời khi tìm thấy dữ liệu nội bộ phù hợp.
CHATBOT_KNOWLEDGE_ONLY=true
CHATBOT_KNOWLEDGE_REQUIRE_AUTH=true
CHATBOT_RETRIEVAL_LIMIT=6
CHATBOT_RETRIEVAL_CANDIDATES=500
CHATBOT_CHUNK_SIZE=1400
CHATBOT_CHUNK_OVERLAP=180
CHATBOT_MAX_KNOWLEDGE_FILE_SIZE=20971520

# Có thể ghi đè prompt mặc định bằng một dòng duy nhất.
CHATBOT_SYSTEM_PROMPT=
